{
  "name": "@z-ux/charts",
  "version": "0.1.0",
  "description": "Z-UI chart components built on visx",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zurmely/ui.git",
    "directory": "packages/charts"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": ["**/*.css"],
  "files": ["dist", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "import": "./dist/primitives/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./line-chart": {
      "types": "./dist/components/line-chart/index.d.ts",
      "import": "./dist/components/line-chart/index.js"
    },
    "./area-chart": {
      "types": "./dist/components/area-chart/index.d.ts",
      "import": "./dist/components/area-chart/index.js"
    },
    "./bar-chart": {
      "types": "./dist/components/bar-chart/index.d.ts",
      "import": "./dist/components/bar-chart/index.js"
    },
    "./pie-chart": {
      "types": "./dist/components/pie-chart/index.d.ts",
      "import": "./dist/components/pie-chart/index.js"
    },
    "./scatter-chart": {
      "types": "./dist/components/scatter-chart/index.d.ts",
      "import": "./dist/components/scatter-chart/index.js"
    },
    "./sparkline": {
      "types": "./dist/components/sparkline/index.d.ts",
      "import": "./dist/components/sparkline/index.js"
    },
    "./heatmap-chart": {
      "types": "./dist/components/heatmap-chart/index.d.ts",
      "import": "./dist/components/heatmap-chart/index.js"
    },
    "./treemap-chart": {
      "types": "./dist/components/treemap-chart/index.d.ts",
      "import": "./dist/components/treemap-chart/index.js"
    },
    "./box-plot-chart": {
      "types": "./dist/components/box-plot-chart/index.d.ts",
      "import": "./dist/components/box-plot-chart/index.js"
    },
    "./histogram-chart": {
      "types": "./dist/components/histogram-chart/index.d.ts",
      "import": "./dist/components/histogram-chart/index.js"
    },
    "./radial-bar-chart": {
      "types": "./dist/components/radial-bar-chart/index.d.ts",
      "import": "./dist/components/radial-bar-chart/index.js"
    },
    "./bubble-chart": {
      "types": "./dist/components/bubble-chart/index.d.ts",
      "import": "./dist/components/bubble-chart/index.js"
    },
    "./stream-chart": {
      "types": "./dist/components/stream-chart/index.d.ts",
      "import": "./dist/components/stream-chart/index.js"
    },
    "./threshold-chart": {
      "types": "./dist/components/threshold-chart/index.d.ts",
      "import": "./dist/components/threshold-chart/index.js"
    },
    "./network-chart": {
      "types": "./dist/components/network-chart/index.d.ts",
      "import": "./dist/components/network-chart/index.js"
    },
    "./candlestick-chart": {
      "types": "./dist/components/candlestick-chart/index.d.ts",
      "import": "./dist/components/candlestick-chart/index.js"
    },
    "./funnel-chart": {
      "types": "./dist/components/funnel-chart/index.d.ts",
      "import": "./dist/components/funnel-chart/index.js"
    },
    "./waterfall-chart": {
      "types": "./dist/components/waterfall-chart/index.d.ts",
      "import": "./dist/components/waterfall-chart/index.js"
    }
  },
  "scripts": {
    "build": "tsup && node scripts/copy-css.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@z-ux/tokens": "^0.1.0",
    "@z-ux/ui": "^0.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@visx/axis": "^3.12.0",
    "@visx/curve": "^3.12.0",
    "@visx/event": "^3.12.0",
    "@visx/glyph": "^3.12.0",
    "@visx/gradient": "^3.12.0",
    "@visx/grid": "^3.12.0",
    "@visx/group": "^3.12.0",
    "@visx/heatmap": "^3.12.0",
    "@visx/hierarchy": "^3.12.0",
    "@visx/legend": "^3.12.0",
    "@visx/network": "^3.12.0",
    "@visx/pattern": "^3.12.0",
    "@visx/responsive": "^3.12.0",
    "@visx/scale": "^3.12.0",
    "@visx/shape": "^3.12.0",
    "@visx/stats": "^3.12.0",
    "@visx/threshold": "^3.12.0",
    "@visx/tooltip": "^3.12.0",
    "@visx/vendor": "^3.12.0"
  },
  "devDependencies": {
    "@z-ux/tokens": "workspace:*",
    "@z-ux/ui": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9",
    "vitest-axe": "^0.1.0"
  }
}
