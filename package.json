{
  "name": "z-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @z-ui/docs dev",
    "docs": "pnpm --filter @z-ui/docs dev",
    "dev:preview": "pnpm --filter @z-ui/preview dev",
    "dev:ui": "pnpm --filter @z-ux/ui dev",
    "preview": "pnpm --filter @z-ui/preview dev",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "version:packages": "node scripts/bump-publishable-versions.mjs",
    "publish:packages": "pnpm --filter @z-ux/tokens publish --access public --no-git-checks && pnpm --filter @z-ux/ui publish --access public --no-git-checks && pnpm --filter @z-ux/charts publish --access public --no-git-checks"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  },
  "packageManager": "pnpm@10.6.5"
}
